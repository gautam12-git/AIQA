# Copy to .env and fill in. NEVER commit the real .env.

# --- LLM: OpenAI primary, Anthropic fallback ---
LLM_PROVIDER=openai
LLM_ORDER=openai,anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional: alter API endpoints/version if required.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# --- Legacy GLM provider (optional) ---
GLM_API_KEY=
# Confirm the exact base URL + model id from your provider dashboard:
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# --- Persistence: MySQL (database "aiqa" on localhost) ---
# Fill in your MySQL user + password. Host/port/db default to localhost:3306/aiqa.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=aiqa
MYSQL_USER=root
MYSQL_PASSWORD=
# Or override the whole URL (wins over the parts above):
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/aiqa
DATABASE_URL=

# --- Evidence object storage (optional) ---
EVIDENCE_BUCKET=

# --- CORS (frontend origin) ---
# CORS_ORIGINS=["http://localhost:3000"]
