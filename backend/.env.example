# Copy to .env and fill in. NEVER commit the real .env.

# --- LLM (GLM / Zhipu by default; any OpenAI-compatible endpoint works) ---
GLM_API_KEY=
# Confirm the exact base URL + model id from your provider dashboard:
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# --- Persistence: MySQL (database "aiqa" on localhost) ---
# Fill in your MySQL user + password. Host/port/db default to localhost:3306/aiqa.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=aiqa
MYSQL_USER=root
MYSQL_PASSWORD=
# Or override the whole URL (wins over the parts above):
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/aiqa
DATABASE_URL=

# --- Evidence object storage (optional) ---
EVIDENCE_BUCKET=

# --- CORS (frontend origin) ---
# CORS_ORIGINS=["http://localhost:3000"]
